# ==============================================================================
# Zynqo Social - Environment Variables Configuration
# ==============================================================================

# Server Port
PORT=5000

# Google OAuth 2.0 Credentials
# Obtain these from the Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create a project and configure the OAuth consent screen.
# 2. Create an OAuth 2.0 Client ID (Web Application).
# 3. Add Authorized JavaScript Origins:
#    - http://localhost:5000
#    - http://localhost:5173
# 4. Add Authorized Redirect URIs:
#    - http://localhost:5000/api/user/auth/google/callback
#    - http://localhost:5173/api/user/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/user/auth/google/callback

# Optional: Google Gemini API Key
GEMINI_API_KEY=
